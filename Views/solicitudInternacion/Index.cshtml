@model solicitudInternacion.Models.DTOs.solicitudInternacionDto;

@{
    ViewData["Title"] = "Permisos de internación - Solicitud en línea";
}

<!-- Modal para mostrar detalles de un beneficiario -->
<div class="modal fade" id="modalBuscarUPP" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo">Agregar UPP/PSG</h5>
                <button type="button" class="btn-close" onclick="event.stopPropagation();cerrarModalUPP();" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalCuerpo">
                <div id="alertaAltaUPP">
                    <label class="alert alert-warning">
                        @* <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i> *@
                        <span><i class="bi bi-info-circle me-2"></i>La UPP/PSG que se mando a validar no exisste en el catálogo. Para continuar con el trámite deberá de ingresar los datos de la UPP/PSG</span>
                        <span class="d-block text-center mt-3"><a href="#" class="text-decoration-none" onclick="ocultarSecciones(event);">Continuar con el trámite</a></span>
                    </label>
                </div>
                <div id="datosAltaUPP" class="d-none">
                    <!--Tabs para el registro de la información-->
                    <ul class="nav nav-tabs mt-3" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="productor-tab" data-bs-toggle="tab" data-bs-target="#productor-tab-pane" type="button" role="tab" aria-controls="desparasitacion-tab-pane" aria-selected="true">Productor</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="upp-tab" data-bs-toggle="tab" data-bs-target="#upp-tab-pane" type="button" role="tab" aria-controls="vacunacion-tab-pane" aria-selected="false">UPP/PSG</button>
                        </li>
                    </ul>
                    <!--Sección con los datos de cada tab-->
                    <div class="tab-content p-3" id="myTabContent">
                        <div class="tab-pane fade show active" id="productor-tab-pane" role="tabpanel" aria-labelledby="productor-tab" tabindex="0">
                            <!--Datos del productor-->
                            <div class="row">
                                <div class="col-12 p-2">
                                    <label for="txtCURPProductor">CURP:</label>
                                    <input type="text" id="txtCURPProductor" class="form-control w-100 me-0 me-md-2" maxlenght="100" placeholder="Escibe la CURP del productor" onblur="validarCURP(this.value)" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-md-4">
                                    <label for="txtNombreProductor">Nombre:</label>
                                    <input type="text" id="txtNombreProductor" class="form-control" placeholder="Nombre del productor" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="txtApellidoPaternoProductor">Apellido paterno:</label>
                                    <input type="text" id="txtApellidoPaternoProductor" class="form-control" placeholder="Apellido paterno del productor" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="txtApellidoMaternoProductor">Apellido materno:</label>
                                    <input type="text" id="txtApellidoMaternoProductor" class="form-control" placeholder="Apellido materno del productor" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-md-4">
                                    <label for="cmbGeneroProductor">Género:</label>
                                    <select id="cmbGeneroProductor" class="form-select">
                                        <option value="">Seleccione...</option>
                                        <option value="M">Masculino</option>
                                        <option value="F">Femenino</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="txtCorreoProductor">Correo electrónico:</label>
                                    <input type="email" id="txtCorreoProductor" class="form-control" placeholder="Correo electrónico del productor" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="txtCelularProductor">Número de celular:</label>
                                    <input type="text" id="txtCelularProductor" class="form-control" maxlength="10" placeholder="Número de celular del productor" />
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="upp-tab-pane" role="tabpanel" aria-labelledby="upp-tab" tabindex="0">
                            <!--Datos de UPP/PSG-->
                            <div class="row">
                                <div class="col-12 col-md-4">
                                    <label for="cmbUPPNuevaEstado">Estado:</label>
                                    <select id="cmbUPPNuevaEstado" class="form-select">
                                        <option value="00">Seleccione un estado...</option>
                                        <option value="30">Veracruz</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="cmbUPPNuevaMunicipio">Municipio:</label>
                                    <select id="cmbUPPNuevaMunicipio" class="form-select">
                                        <option value="000">Seleccione un municipio...</option>
                                        <option value="001">Acajate</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="cmbUPPNuevaLocalidad">Localidad:</label>
                                    <select id="cmbUPPNuevaLocalidad" class="form-select">
                                        <option value="0000">Seleccione una localidad...</option>
                                        <option value="0001">Acajete</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-md-6">
                                    <label for="txtUPPNueva">Clave de la UPP/PSG:</label>
                                    <input type="text" id="txtUPPNueva" class="form-control w-100 me-0 me-md-2" readonly maxlenght="12" placeholder="Escibe la clave de la UPP/PSG" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="txtUPPNuevaNombre">Nombre de la UPP/PSG:</label>
                                    <input type="text" id="txtUPPNuevaNombre" class="form-control w-100 me-0 me-md-2" placeholder="Escibe el nombre de la UPP/PSG" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-md-6">
                                    <label for="txtUPPNuevaLatitud">Latitud:</label>
                                    <input type="number" id="txtUPPNuevaLatitud" class="form-control w-100 me-0 me-md-2" step="0.0001" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="txtUPPNuevaLongitud">Longitud:</label>
                                    <input type="number" id="txtUPPNuevaLongitud" class="form-control w-100 me-0 me-md-2" step="0.0001" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer" id="modalPie">
                <button type="button" id="btnGuardarNuevaUPP" class="btn btn-secondary d-none" onclick="guardarUPP();" >
                    <i class="bi bi-floppy me-2"></i>Guardar
                </button>
                <button type="button" class="btn btn-secondary" onclick="event.stopPropagation();cerrarModalUPP();">
                    <i class="bi bi-x-circle me-2"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<form action="/solicitudInternacion/Index" id="formSolicitud" method="post" novalidate>

    @Html.HiddenFor(model => model.IdSolicitudInternacion)
    @Html.HiddenFor(model => model.FechaCaptura)
    @Html.HiddenFor(model => model.FechaRecepcion)
    @Html.HiddenFor(model => model.StatusSolicitud)
    @Html.AntiForgeryToken()

    <div class="container">
        <div class="card">
            <div class="card-header bg-secondary bg-gradient text-white rounded-top-2">
                <h4 class="m-0">Permisos de internación</h4>
            </div>
            <div class="card-body p-3">

                <div class="row">
                    <div class="col-12 col-md-6">
                        <label for="fechaSolicitud">Fecha de Solicitud:</label>
                        <input id="fechaSolicitud" name="FechaSolicitud" type="date" class="form-control" placeholder="fecha de solicitud" required />
                    </div>
                    <div class="col-12 col-md-6">
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 col-md-6 p-2">
                        <h4 class="w-100 text-center border-bottom mb-2 p-2">Datos del origen</h4>
                        <div class="row">
                            <div class="col-12">
                                <div class="input-group">
                                    <div class="input-group-text" data-bs-toggle="tooltip" data-bs-title="Validar clave de UPP/PSG del origen" id="btnGroupAddonO"><i class="fa fa-check" aria-hidden="true" onclick="buscarUpp('O');" style="cursor: pointer;"></i></div>
                                    <input type="text" id="txtUPPOrigen" name="origen" class="form-control" placeholder="Clave de UPP/PSG del origen" aria-label="Input group example" aria-describedby="btnGroupAddonO" required >
                                </div>
                            </div>
                        </div>
                        <div class="row d-none mt-2" id="datosOrigen">
                            <div class="col-12">
                                <label id="txtNombreRemitente"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtPredioRemitente"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtUbicacionRemitente"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtMunicipioRemitente"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtEstadoRemitente"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtZonaRemitente"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtStatusRemitente"></label>
                            </div>
                        </div>
                        <h5 id="alertaOrigen" class="d-none m-3 text-center alert alert-success"></h5>
                    </div>
                    <div class="col-12 col-md-6 p-2">
                        <h4 class="w-100 text-center border-bottom mb-2 p-2">Datos del destino</h4>
                        <div class="row">
                            <div class="col-12">
                                <div class="input-group">
                                    <div class="input-group-text" id="btnGroupAddonD" data-bs-toggle="tooltip" data-bs-title="Validar clave de UPP/PSG del destino"><i class="fa fa-check" aria-hidden="true" onclick="buscarUpp('D');" style="cursor: pointer;"></i></div>
                                    <input type="text" id="txtUPPDestino" name="destino" class="form-control" placeholder="Clave de UPP/PSG del destino" aria-label="Input group example" aria-describedby="btnGroupAddonD" required >
                                </div>
                            </div>
                        </div>
                        <div class="row d-none mt-2" id="datosDestino">
                            <div class="col-12">
                                <label id="txtNombreDestino"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtPredioDestino"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtUbicacionDestino"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtMunicipioDestino"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtEstadoDestino"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtZonaDestino"></label>
                            </div>
                            <div class="col-12">
                                <label id="txtStatusDestino"></label>
                            </div>
                        </div>
                        <h5 id="alertaDestino" class="d-none m-3 text-center alert alert-success"></h5>
                    </div>
                </div>

                <div id="continuarTramite" class="d-none">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <label for="correoElectronico" data-bs-toggle="tooltip" data-bs-title="Correo electrónico para recibir notificaciones del trámite">Correo electrónico:</label>
                            <input id="correoElectronico" name="correoElectronico" type="email" class="form-control" placeholder="usuario@ejemplo.com" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="numeroCelular" data-bs-toggle="tooltip" data-bs-title="Número de celular para recibir notificaciones del trámite">Número de celular:</label>
                            <input id="numeroCelular" name="numeroCelular" type="text" class="form-control" placeholder="9999999999 (Sólo números sin espacios o guiones a 10 posiciones)" />
                        </div>
                    </div>

                    <h6 class="mt-3 mb-0 text-center"><strong>DATOS DE LA MOVILIZACIÓN</strong></h6>
                    <div class="row mt-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label for="tipoMovilizacion">Motivo:</label>
                            <input type="text" id="tipoMovilizacion" class="form-control" readonly />
                            <input type="hidden" id="motivoTraslado" name="motivoTraslado" readonly />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="guiaTraslado">Guía de traslado:</label>
                            <input id="guiaTraslado" name="guiaTraslado" type="text" class="form-control" placeholder="Certificado zoosanitario para movilización" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="folioREEMO">REEMO:</label>
                            <input id="folioREEMO" name="folioREEMO" type="text" class="form-control" placeholder="Certificado zoosanitario para movilización" required />
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label for="tipoGanado">Tipo de Ganado:</label>
                            <select id="tipoGanado" name="TipoGanado" class="form-control" required>
                                <option value="0">Seleccione...</option>
                                <option value="1">Bovino</option>
                                <option value="2">Ovino</option>
                                <option value="3">Caprino</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="hembras">Hembras:</label>
                            <input id="hembras" name="HembrasMovilizar" type="number" class="form-control" placeholder="Hembras" value="0" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="machos">Machos:</label>
                            <input id="machos" name="MachosMovilizar" type="number" class="form-control" placeholder="Machos" value="0" required />
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label for="marcaVehiculo">Marca del Vehículo:</label>
                            <input id="marcaVehiculo" name="marcaVehiculo" type="text" class="form-control" placeholder="Marca del Vehículo" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="numeroPlacas">Número de Placas:</label>
                            <input id="numeroPlacas" name="PlacasVehiculo" type="text" class="form-control" placeholder="Número de Placas" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="nombreChofer">Nombre del Chofer:</label>
                            <input id="nombreChofer" name="NombreChofer" type="text" class="form-control " placeholder="Nombre del Chofer" required />
                        </div>
                        <div class="mt-2 mb-2">
                            <label for="puntosVerificacion">Puntos de verificación en la ruta de ingreso y/o tránsito:</label>
                            <input id="puntosVerificacion" name="puntosVerificacion" type="text" class="form-control w-100" placeholder="Puntos de verificación en la ruta de ingreso y/o tránsito" required />
                        </div>
                    </div>

                    <h6 class="mt-3 mb-0 text-center"><strong>REQUERIMIENTOS PARA LA MOVILIZACIÓN</strong></h6>
                    <div class="row mt-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label for="certificadoMovilizacion">Certificado Zoosanitario:</label>
                            <input id="certificadoMovilizacion" name="certificadoMovilizacion" type="text" class="form-control " placeholder="Certificado zoosanitario" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="dictamenTB">Dictamen negativo de Tb:</label>
                            <input id="dictamenTB" name="dictamenTB" type="text" class="form-control " placeholder="Dictamen negativo de Tb" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="dictamenBR">Dictamen negativo de Br:</label>
                            <input id="dictamenBR" name="dictamenBR" type="text" class="form-control " placeholder="Dictamen negativo de Br" required />
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label for="numeroFlejes">Folio de fleje:</label>
                            <input id="numeroFlejes" name="numeroFlejes" type="text" class="form-control " placeholder="Vehículo flejado" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="factura">Factura:</label>
                            <input id="factura" name="factura" type="text" class="form-control " placeholder="Factura" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="marcajeCN">Marcaje CN:</label>
                            <input id="marcajeCN" name="marcajeCN" type="text" class="form-control " placeholder="Marcaje CN" required />
                        </div>
                    </div>
                </div>

                <div id="divErrores" class="alert alert-warning m-5 fs-5 d-none" role="alert">
                    <span class="d-block text-center"><i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i>Lista de errores</span>
                    <ul class="mt-2" id="listaErrores">
                    </ul>
                </div>

            </div>

            <div class="card-footer bg-light">
                <button id="btnGuardar" type="submit" class="btn btn-light disabled">
                    <i class="fa fa-save me-2" aria-hidden="true"></i>Continuar con la carga de documentos
                </button>
            </div>

        </div>
    </div>

</form>
