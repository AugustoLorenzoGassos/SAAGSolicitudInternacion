@model solicitudInternacion.ViewModels.datosSolicitud

@{
    ViewData["Title"] = "Permisos de internación - Finalizar trámite";
}

<div class="container mt-3">
    <div class="card">
        <div class="card-header bg-secondary bg-gradient text-white rounded-top-2">
            <h4 class="m-0">Permisos de internación - Notificación</h4>
        </div>
        <div class="card-body">

                <div class="container mt-3">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-6 alert alert-success">

                            <span class="d-block p-2 text-center"><strong>Estimado: @Model.productor?.NombreProductor @Model.productor?.ApellidoPaternoProductor @Model.productor?.ApellidoMaternoProductor</strong></span>
                            <span class="d-block p-2">Su trámite con folio <strong>@Model.solicitud?.IdSolicitudInternacion</strong> fue recibido. Se le estarán haciendo llegar notificaciones de la atención al <strong>correo electrónico @Model.solicitud?.CorreoElectronico</strong> y/o al <strong>número de celular @Model.solicitud?.NumeroCelular</strong></span>
                            <span class="d-block p-2 ms-2"><strong><i class="fa fa-step-backward me-2" aria-hidden="true"></i>Origen:</strong> @Model.solicitud?.Origen el el municipio: @Model.productor?.NombreMunicipio y localidad: @Model.productor?.NombreLocalidad</span>
                            <span class="d-block p-2 ms-2"><strong><i class="fa fa-step-forward me-2" aria-hidden="true"></i>Destino:</strong> @Model.solicitud?.Destino el el municipio: @Model.productorDestino?.NombreMunicipio y localidad: @Model.productorDestino?.NombreLocalidad</span>

                        </div>

                        <div class="col-12 col-md-6 text-center">
                            <p class="mb-2">Escanea el código QR para dar seguimiento:</p>
                            <div id="qrcode" class="d-inline-block p-2 bg-white border rounded shadow-sm mx-auto"></div>
                        </div>

                    </div>
                </div>


        </div>
        <div class="card-footer">
            <a href="@Url.Action("Index", "solicitudInternacion")" class="btn btn-ligth">
                <i class="fa fa-home me-3" aria-hidden="true"></i>Iniciar nuevo tramite
            </a>
        </div>
    </div>
</div>

<script type="text/javascript">

    document.addEventListener("DOMContentLoaded", function() {
        // Generar la URL a la que apuntará el QR (ej. la ruta de seguimiento de tu app)
        // Usamos el ID o la clave de la solicitud para que el enlace sea único
        var urlSeguimiento = "@Url.Action("solicitudInternacionSeguimiento", "solicitudInternacion", new { id = Model.solicitud?.IdSolicitudInternacion }, Context.Request.Scheme)";

        // Crear el código QR dentro del div 'qrcode'
        var qrcode = new QRCode(document.getElementById("qrcode"), {
            text: urlSeguimiento,
            width: 128,  // Ancho en píxeles
            height: 128, // Alto en píxeles
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        });

    });

</script>